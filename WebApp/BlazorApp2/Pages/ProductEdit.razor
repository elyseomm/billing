@page "/product/edit/{id}"
@using Billing.Core.Utils
@using BlazorApp2.Model
@using System.Text
@using System.Security.Cryptography
@using Newtonsoft.Json.Linq
@inject BlazorApp2.API.ProductApiClient Client

@inject NavigationManager Navigation

<PageTitle>Billing - Products - Edit</PageTitle>

<h1>Products</h1>

<p>Product data from the server.</p>

@if (product == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="mb-3">
        <label for="name" class="form-label">Product Name</label>
        <input type="text" class="form-control" id="name" @bind="@product.ProductName" />
    </div>
    
    <button class="btn btn-secondary" @onclick="Cancel">Cancel</button>
    <button class="btn btn-primary" @onclick="Update">Save</button>
    
}

@code {
    [Parameter]
    public string Id { get; set; } = "";
    private Product? product;

    protected override async Task OnInitializedAsync()
    {
        product = await Client.GetById(Id!);

        //Console.WriteLine(JObject.FromObject(customer).ToString() );
    }

    private async Task Update()
    {
        // Update the product using the service
        var resp = await Client.Update(product!);

        Console.WriteLine(resp);

        // Redirect back to the product list page
        Navigation.NavigateTo("/products");
    }

    private void Cancel()
    {
        // Navigate back to the product list page
        Navigation.NavigateTo("/products");
    }

}


