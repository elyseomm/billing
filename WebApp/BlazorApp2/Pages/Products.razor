@page "/products"
@using BlazorApp2.Model
@inject HttpClient Http
@inject BlazorApp2.API.ProductApiClient Client
@inject NavigationManager Navigation
@using BlazorApp2.Components

<PageTitle>Billing - Products</PageTitle>

<h1>Products</h1>

<p>Products data from the server.</p>

@if (products == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <label type="button" class="btn btn-primary btn-block" @onclick=@(() => New())>
        <span class="icon-plus"></span> Add new product
    </label>
    <table class="table">
        <thead>
            <tr>
                <th>Product Name</th>
                <th>Active</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in products)
            {
                GetActiveStatus(@row.IsActive);
                <tr>
                    <td>@row.ProductName</td>
                    <td>
                        <div class="form-check mt-3">
                            <InputCheckbox @bind-value="@row.IsActive" class="form-check-input" disabled />
                        </div>
                    </td>
                    <td>
                        <label type="button" @onclick=@(() => EditBy(row.Id!)) class="btn btn-warning btn-block">
                            <span class="icon-plus"></span> Edit
                        </label>
                        <label type="button" @onclick="() => OnOpenModalDialog(row)" class="@ActiveStatusClass">
                            <span class="icon-plus"></span>
                            @ActiveStatusMessage
                        </label>
                    </td>
                </tr>


            }
        </tbody>
    </table>
}

<ModalDialog @ref="@ModalDialog" Title="Removing Product">
    <div class="row">
        <h3>@Message</h3>
        <div class="dialog-buttons">
            <button class="btn btn-secondary" @onclick="() => OnCloseModalDialog(false)">Close</button>
            <button class="btn btn-primary" @onclick="() => OnCloseModalDialog(true)">Yes</button>
        </div>
    </div>
</ModalDialog>


@code {
    private Product[]? products;

    private ModalDialog ModalDialog { get; set; }

    public string? Message { get; set; }

    public string? ActiveStatusMessage { get; set; }
    public string? ActiveStatusClass { get; set; }

    protected override async Task OnInitializedAsync()
    {
        products = await Client.GetAll();
    }

    void New()
    {
        //string key = CustomConverter.Encodeb64ToHex(id);
        //string key = BitConverter.ToString(Convert.FromBase64String(b64Id)).Replace("-", "");
        Navigation.NavigateTo($"/product/new");
    }

    void EditBy(string id)
    {
        //string key = CustomConverter.Encodeb64ToHex(id);
        //string key = BitConverter.ToString(Convert.FromBase64String(b64Id)).Replace("-", "");
        Navigation.NavigateTo($"/product/edit/{id}");
    }

    void DeleteBy(string id)
    {
        Navigation.NavigateTo("/product/" + id);
    }

    void GetActiveStatus(bool isActive)
    {
        ActiveStatusClass = isActive ? "btn btn-danger btn-block" : "btn btn-success btn-block";
        ActiveStatusMessage = isActive ? "Remove" : "Reactivate";
    }

    #region Modal

    private async void OnOpenModalDialog(Product row)
    {
        Message = row.IsActive ? "Do you really wants to remove this entry ?" : "Do you really wants to reactivate this entry ?";
        ModalDialog.Open(row.Id!);
    }

    private async void OnCloseModalDialog(bool accepted)
    {
        ModalDialog.Close(accepted);
        if (accepted)
        {
            if (!String.IsNullOrEmpty(ModalDialog.KeyIdentifier))
            {
                var product = await Client.GetById(ModalDialog.KeyIdentifier);
                if(product != null && product.Id != null)
                {
                    product.Active = product.IsActive ? 0 : 1;
                    await Client.Update(product);
                    products = await Client.GetAll();
                    StateHasChanged();
                }
            }
        }
    }

    #endregion
}


